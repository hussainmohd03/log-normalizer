# ─── Compose variable substitution ────────────────────────────────────
# Copy to .env (gitignored) and fill in real values before running
# `docker compose up`. Variables marked REQUIRED have no defaults and
# compose will refuse to start without them.

# ── Postgres ────────────────────────────────────────────────────────
POSTGRES_USER=lognorm
POSTGRES_PASSWORD=lognorm
POSTGRES_DB=lognormalizer

# ── Backend secrets (REQUIRED) ──────────────────────────────────────
# API_KEY: machine-client auth header value (x-api-key)
API_KEY=change-me-to-a-long-random-string

# JWT_SECRET: signs all JWTs. Rotate to invalidate every active session.
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars

# JWT_TTL_HOURS: how long a session cookie is valid before forcing re-login.
JWT_TTL_HOURS=24

# Bootstrap admin: created on first backend start if no admin exists.
# Idempotent — safe to leave set across restarts.
BOOTSTRAP_ADMIN_EMAIL=admin@local.dev
BOOTSTRAP_ADMIN_PASSWORD=changemechangemechangeme

# ── CORS ────────────────────────────────────────────────────────────
# Frontend origin allowed to send credentialed requests. Must match
# wherever the React app is actually served from.
#   Prod (nginx in compose):  http://localhost:8080
#   Dev (vite via override):  http://localhost:5173
CORS_ORIGIN=http://localhost:8080

# ── Frontend build-time config ──────────────────────────────────────
# Inlined into the bundle by vite — change requires `docker compose
# build frontend`. Must point at where the backend is reachable from
# the user's BROWSER, not from inside the container network.
VITE_API_URL=http://localhost:3000/api

# ── Port mapping (host side) ────────────────────────────────────────
BACKEND_PORT=3000
FRONTEND_PORT=8080

# ── SLM ─────────────────────────────────────────────────────────────
MODEL_PATH=/app/models

# ── AWS / SQS (optional) ────────────────────────────────────────────
# Leave blank in dev — SQSClientService will throw on startup if these
# are unset. For dev with no AWS, comment out backend services that
# touch SQS or set these to dummy values.
AWS_REGION=
SQS_QUEUE_URL=

# ── SLM circuit breaker (opossum) ───────────────────────────────────
TIMEOUT=860000
ERROR_THRESHOLD_PERCENTAGE=50
RESET_TIMEOUT=60000
VOLUME_THRESHOLD=5

# ── Image tag (optional) ────────────────────────────────────────────
IMAGE_TAG=latest
