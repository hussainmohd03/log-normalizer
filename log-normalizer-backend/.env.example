
PORT=3000
DATABASE_URL="postgresql://postgres:12345678@localhost:5432/log-normalizer"
REDIS_URL="redis://localhost:6379"
API_KEY="SECRET"


# SLM Service Configurations
SLM_API="http://localhost:8000"

# SQS configurations
SQS_QUEUE_URL=""
AWS_REGION=""

# Jobs configurations
PENDING_BATCH_SIZE=10
SQS_BATCH_SIZE=10

# Reconciliation sweep
RECONCILE_STUCK_ACTIVE_MINUTES=15
RECONCILE_STUCK_QUEUED_MINUTES=60
RECONCILE_BATCH_SIZE=100
IDEMPOTENCY_KEY_RETENTION_HOURS=24

# Circuit Breaker Configurations
TIMEOUT=15000
ERROR_THRESHOLD_PERCENTAGE=50
RESET_TIMEOUT=60000
VOLUME_THRESHOLD=5

# Auth 
JWT_SECRET="change-me-to-a-long-random-string"
JWT_TTL_HOURS=24

# Set both to bootstrap an admin user on first startup; idempotent.
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""

# Frontend origin for CORS in dev (omit in same-origin prod)
CORS_ORIGIN="http://localhost:5173"