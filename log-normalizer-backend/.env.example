# Loaded by docker-compose via env_file: directive.
# Copy to .env and fill in real values.

NODE_ENV=production
PORT=3000

# -- Database -------------------------------------------------------
# Postgres credentials. Consumed by the `postgres` service AND used
# to construct DATABASE_URL below. Keep the two in sync.
POSTGRES_USER=lognorm
POSTGRES_PASSWORD=lognorm
POSTGRES_DB=lognormalizer

# Full connection string. Host "postgres" is the Docker Compose
# service name — resolves on the internal network. If running the
# backend outside Docker, change to localhost:5432.
DATABASE_URL=postgresql://lognorm:lognorm@postgres:5432/lognormalizer

# -- Redis / SLM ----------------------------------------------------
# Hostnames match Docker Compose service names.
REDIS_URL=redis://redis:6379
SLM_API=http://slm:8000

# -- Auth -----------------------------------------------------------
API_KEY=change-me-to-a-random-string
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_HOURS=24

# Set both to bootstrap an admin user on first startup; idempotent.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# -- CORS -----------------------------------------------------------
# Frontend origin for CORS in dev (omit in same-origin prod).
CORS_ORIGIN=http://localhost:8080

# -- SQS ------------------------------------------------------------
SQS_QUEUE_URL=
AWS_REGION=

# -- Jobs -----------------------------------------------------------
PENDING_BATCH_SIZE=10
SQS_BATCH_SIZE=10

# -- Reconciliation sweep -------------------------------------------
RECONCILE_STUCK_ACTIVE_MINUTES=15
RECONCILE_STUCK_QUEUED_MINUTES=60
RECONCILE_BATCH_SIZE=100
IDEMPOTENCY_KEY_RETENTION_HOURS=24

# -- Circuit Breaker ------------------------------------------------
TIMEOUT=860000
ERROR_THRESHOLD_PERCENTAGE=50
RESET_TIMEOUT=60000
VOLUME_THRESHOLD=5
