# Loaded by docker-compose as a build arg (frontend image is built
# with VITE_API_URL baked in). Copy to .env for local `npm run dev`.
#
# VITE_* variables are compiled into the JS bundle and visible in
# the browser — NEVER put secrets here. UI auth is via httpOnly JWT
# cookie set by the backend, so no API key is needed client-side.

VITE_API_URL=http://localhost:3000/api
